# AENA MCP configuration
#
# The public website API needs NO credentials — the server works out of the box
# (discovery up to ~14 days ahead, no past data, local times).
#
# The richer REST API (OAuth2 Azure AD) needs a client secret. With it you get
# past flights (~54h), codeshare operator (mainFlight), and UTC timestamps.
# client_id and tenant_id have working defaults baked in; only the secret is required.

AENA_CLIENT_ID=34242493-003c-407a-b399-30eb2a280614
AENA_CLIENT_SECRET=
AENA_TENANT_ID=3ea6ba9c-a793-4c35-b1c1-e9d182879576
